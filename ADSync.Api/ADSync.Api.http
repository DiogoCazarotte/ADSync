
@host = https://localhost:7092

# Testes consolidados dos passos 1, 2 e 3.
# Digite a senha de desenvolvimento nos logins. NÃO faça commit deste arquivo preenchido.
# Rode antes o banco-supabase.sql no Supabase.

### Login Gestor
# @name loginGestor
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "paulo.gestor@sustennutri.com.br", "senha": "" }

### Login Técnico
# @name loginTecnico
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "carlos.tecnico@sustennutri.com.br", "senha": "" }
   
### Login Operador
# @name loginOperador
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "renata.operadora@sustennutri.com.br", "senha": "" }

### Listagens (pegam os IDs automaticamente)
# @name listaEquipamentos
GET {{host}}/api/equipamentos
Authorization: Bearer {{loginGestor.response.body.$.token}}

###
# @name listaCausas
GET {{host}}/api/causas-falha
Authorization: Bearer {{loginGestor.response.body.$.token}}

###
# @name listaPecas
GET {{host}}/api/pecas
Authorization: Bearer {{loginGestor.response.body.$.token}}

###
# @name listaTecnicos
GET {{host}}/api/usuarios?tipo=Tecnico
Authorization: Bearer {{loginGestor.response.body.$.token}}


###############################################################
# PASSO 1 — Cadastros de apoio
###############################################################

### Operador tentando listar usuários -> 403 (só Gestor)
GET {{host}}/api/usuarios
Authorization: Bearer {{loginOperador.response.body.$.token}}

### Gestor cria equipamento -> 201
# @name novoEquipamento
POST {{host}}/api/equipamentos
Authorization: Bearer {{loginGestor.response.body.$.token}}
Content-Type: application/json

{ "nome": "Esteira Transportadora 01", "codigoPatrimonio": "EST-001", "setor": "Ensaque" }

### Repetir com código em minúsculas -> 409 (duplicado, ignora maiúsculas/minúsculas)
POST {{host}}/api/equipamentos
Authorization: Bearer {{loginGestor.response.body.$.token}}
Content-Type: application/json

{ "nome": "Esteira Transportadora 02", "codigoPatrimonio": "est-001", "setor": "Ensaque" }

### Gestor cria peça crítica -> 201, critica = true
POST {{host}}/api/pecas
Authorization: Bearer {{loginGestor.response.body.$.token}}
Content-Type: application/json

{ "codigo": "ROL-6204", "nome": "Rolamento 6204", "quantidadeInicial": 5, "critica": true }

### Gestor registra entrada de estoque na primeira peça da lista
POST {{host}}/api/pecas/{{listaPecas.response.body.$[0].id}}/entrada
Authorization: Bearer {{loginGestor.response.body.$.token}}
Content-Type: application/json

{ "quantidade": 10 }

### Gestor tenta inativar equipamento com O.S. em aberto -> 409
#   (use um equipamento que já tenha O.S. Aberta/EmAndamento/Pausada; ajuste o ID se precisar)
POST {{host}}/api/equipamentos/{{listaEquipamentos.response.body.$[0].id}}/inativar
Authorization: Bearer {{loginGestor.response.body.$.token}}


###############################################################
# PASSO 2 — Número da O.S. por sequence e tipo de manutenção
###############################################################

### 1) Operador abre O.S. corretiva -> 201, numeroOS tipo OS-2026-00001, tipoManutencao "Corretiva"
POST {{host}}/api/ordensservico
Authorization: Bearer {{loginOperador.response.body.$.token}}
Content-Type: application/json

{
  "equipamentoId": "{{listaEquipamentos.response.body.$[0].id}}",
  "descricaoProblema": "Teste - corretiva",
  "prioridade": "Media"
}

### 2) Abrir outra -> o número deve ser o seguinte, sem repetir
POST {{host}}/api/ordensservico
Authorization: Bearer {{loginOperador.response.body.$.token}}
Content-Type: application/json

{
  "equipamentoId": "{{listaEquipamentos.response.body.$[0].id}}",
  "descricaoProblema": "Teste - segunda O.S.",
  "prioridade": "Baixa"
}

### 3) Operador tenta abrir PREVENTIVA -> 403
POST {{host}}/api/ordensservico
Authorization: Bearer {{loginOperador.response.body.$.token}}
Content-Type: application/json

{
  "equipamentoId": "{{listaEquipamentos.response.body.$[0].id}}",
  "descricaoProblema": "Teste - preventiva pelo operador",
  "tipoManutencao": "Preventiva"
}

### 4) Gestor abre PREVENTIVA -> 201, tipoManutencao "Preventiva"
POST {{host}}/api/ordensservico
Authorization: Bearer {{loginGestor.response.body.$.token}}
Content-Type: application/json

{
  "equipamentoId": "{{listaEquipamentos.response.body.$[0].id}}",
  "descricaoProblema": "Lubrificação programada",
  "prioridade": "Baixa",
  "tipoManutencao": "Preventiva"
}


###############################################################
# PASSO 3 — Planos preventivos e geração automática
###############################################################

### 1) Gestor cria plano com ProximaExecucao = HOJE -> 201
#    Troque a data abaixo pela data de hoje (AAAA-MM-DD)
POST {{host}}/api/planos-preventivos
Authorization: Bearer {{loginGestor.response.body.$.token}}
Content-Type: application/json

{
  "equipamentoId": "{{listaEquipamentos.response.body.$[0].id}}",
  "tecnicoResponsavelId": "{{listaTecnicos.response.body.$[0].id}}",
  "descricao": "Lubrificação geral",
  "periodicidadeDias": 30,
  "proximaExecucao": "2026-10-23"
}

### 2) Técnico tentando criar plano -> 403 (só o Gestor planeja)
POST {{host}}/api/planos-preventivos
Authorization: Bearer {{loginTecnico.response.body.$.token}}
Content-Type: application/json

{
  "equipamentoId": "{{listaEquipamentos.response.body.$[0].id}}",
  "tecnicoResponsavelId": "{{listaTecnicos.response.body.$[0].id}}",
  "descricao": "Teste",
  "periodicidadeDias": 10,
  "proximaExecucao": "2026-10-23"
}

### 3) Listar planos (qualquer perfil)
GET {{host}}/api/planos-preventivos
Authorization: Bearer {{loginTecnico.response.body.$.token}}

### 4) Esperar ~10s após a API subir (ou até a próxima hora cheia) e então listar as
#    O.S. do técnico -> deve aparecer uma nova, com tipoManutencao "Preventiva",
#    geradaAutomaticamente true, já atribuída a ele
GET {{host}}/api/ordensservico?minhas=true
Authorization: Bearer {{loginTecnico.response.body.$.token}}

### 5) Repetir o bloco 4 enquanto essa O.S. ainda está Aberta -> NÃO deve nascer
#    uma segunda O.S. do mesmo plano (só gera a próxima depois de concluir)
