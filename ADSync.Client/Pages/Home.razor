@page "/"
@using ADSync.Application.DTOs
@using ADSync.Client.Services
@inject ManutencaoClient Client
@implements IDisposable
<PageTitle>ADSync • Gestão de ordens de serviço</PageTitle>
@if (Client.ReadOnlyMode) { <p class="message" role="status">Ambiente somente leitura: abertura de O.S., atendimento e alterações estão indisponíveis neste endereço. As consultas usam dados atuais da API.</p> }
<fieldset class="workspace" disabled="@Working">
@if (!ready) { <p role="status">Carregando sessão…</p> }
else if (Client.Session is null)
{
    <section class="login-shell" aria-labelledby="login-title">
        <span class="login-corner-brand" aria-label="ADSync">AD<span>Sync</span></span>
        <div class="login-intro">
            <div class="login-intro-copy">
                <h2>Mais organização.<br />Mais agilidade.<br /><span>Mais controle.</span></h2>
                <p>Conecte sua equipe e simplifique a gestão das ordens de serviço, do primeiro chamado à solução.</p>
            </div>
            <img class="login-logo" src="images/adsync-logo.jpeg" alt="ADSync — Gestão de ordens de serviço. Organização, agilidade e controle." width="1080" height="1062" fetchpriority="high" />
            <div class="login-intro-note">
                <span class="login-note-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="5" width="14" height="16" rx="3" /><path d="M9 5V3h6v2M9 13l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <div><strong>Sua operação, em sintonia.</strong><p>Chamados, equipamentos e manutenção preventiva. Tudo no mesmo lugar para você focar no que importa.</p></div>
            </div>
        </div>
        <div class="login-form-panel">
            <div class="login-form-heading">
                <h1 id="login-title">Uma gestão mais simples <strong>começa aqui.</strong></h1>
                <p>Acesse sua conta e acompanhe o dia a dia da sua equipe.</p>
            </div>
            <EditForm Model="login" OnValidSubmit="Login"><DataAnnotationsValidator />
                <label for="login-email">E-mail <span class="login-required" aria-hidden="true">*</span></label>
                <InputText id="login-email" type="email" @bind-Value="login.Email" autocomplete="username" placeholder="Digite seu e-mail" aria-required="true" />
                <label for="login-password">Senha <span class="login-required" aria-hidden="true">*</span></label>
                <div class="login-password">
                    <InputText id="login-password" type="@(showPassword ? "text" : "password")" @bind-Value="login.Senha" autocomplete="current-password" placeholder="Digite sua senha" aria-required="true" />
                    <button class="login-password-toggle" type="button" @onclick="() => showPassword = !showPassword" aria-label="@(showPassword ? "Ocultar senha" : "Mostrar senha")" aria-pressed="@(showPassword ? "true" : "false")" aria-controls="login-password">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" />@if (showPassword) { <path d="m3 3 18 18" /> }</svg>
                    </button>
                </div>
                <details class="login-recovery"><summary>Esqueceu sua senha?</summary><p>Entre em contato com o gestor da sua equipe para recuperar o acesso.</p></details>
                <button class="login-submit" type="submit" disabled="@Working">@(Working ? "Entrando…" : "Entrar")</button>
                <ValidationSummary />
            </EditForm>
            <p class="login-help">Ainda não tem acesso? <strong>Fale com o gestor da sua equipe.</strong></p>
        </div>
    </section>
}
else
{
    <WorkspaceShell Session="Client.Session" Areas="Areas" ActiveArea="@area" Search="@search" Busy="Working" OnNavigate="Switch" OnSearch="SearchOrders" OnLogout="Logout" OnRefresh="Refresh">
    @if (area == "Visão geral")
    {
        <WorkspaceOverview Name="@Client.Session.Nome" Orders="orders" Plans="plans" Equipment="equipment" Areas="Areas" Pending="Client.Pending" Busy="Working" ReadOnly="Client.ReadOnlyMode" CanSeePlans='@(Client.Role("Gestor") || Client.Role("Tecnico"))' OnNavigate="Switch" OnDetail="ShowOrder" OnSync="Sync" />
    }
    else if (area != "Indicadores")
    {
        <div class="workspace-sync toolbar"><span role="status">@Client.Pending pendência(s) no dispositivo</span><button disabled="@(Working || Client.ReadOnlyMode)" @onclick="Sync"><AppIcon Name="refresh" />Tentar sincronizar</button></div>
    }
    @if (area != "Indicadores") { <p class="workspace-profile-description" role="status">@ProfileDescription</p> }
    @if (Client.TechnicalOfflineEnabled && Client.Role("Tecnico"))
    {
        <p role="status">@Client.PreparationNotice</p>
        <p>Os atendimentos são baixados automaticamente com conexão. Alterações feitas sem rede ficam neste navegador até a confirmação do servidor.</p>
    }
    @if (area == "Ordens de serviço")
    {
        <h1>Ordens de serviço</h1>
        <p>@OrderDescription</p>
        @if (!Client.ReadOnlyMode && (Client.Role("Operador") || Client.Role("Gestor")))
        {
            <details class="card"><summary>Abrir chamado</summary>
                <p>Ao receber o chamado, o sistema atribui o técnico ativo com menos ordens pendentes. Se não houver técnico ativo, o gestor poderá atribuir um responsável depois.</p>
                <EditForm Model="draft" OnValidSubmit="Open"><DataAnnotationsValidator /><ValidationSummary />
                    <label>Equipamento<InputSelect aria-label="Equipamento" @bind-Value="draft.EquipamentoId"><option value="@Guid.Empty">Selecione</option>@foreach(var e in equipment) { <option value="@e.Id">@e.Nome</option> }</InputSelect></label>
                    <label>Descrição do problema<InputTextArea @bind-Value="draft.DescricaoProblema" /></label>
                    <label>Criticidade<InputSelect aria-label="Criticidade" @bind-Value="draft.Prioridade">@foreach(var p in priorities) { <option>@p</option> }</InputSelect></label>
                    <button disabled="@Working">Salvar chamado</button><p>Somente a abertura fica na fila offline. Mantenha o aplicativo aberto para sincronizar.</p>
                </EditForm>
            </details>
        }
        <div class="filters"><label>Buscar equipamento ou número<input @bind="search" @bind:event="oninput" /></label>
            <label>Situação<select aria-label="Situação" @bind="status"><option value="">Todas</option>@foreach(var s in statuses) { <option>@s</option> }</select></label>
            <label>Prioridade<select aria-label="Prioridade" @bind="priority"><option value="">Todas</option>@foreach(var p in priorities) { <option>@p</option> }</select></label>
        </div>
        @if (!Filtered.Any()) { <p>Nenhuma ordem disponível nos filtros atuais.</p> }
        @foreach(var order in Filtered)
        {
            <article class="card"><div class="toolbar"><strong>@order.NumeroOS • @order.EquipamentoNome</strong><span class="badge">@order.Prioridade • @order.Status</span></div><p>@order.DescricaoProblema</p><p>@order.DataAbertura.ToLocalTime().ToString("g") • Responsável: @(order.TecnicoNome ?? "A definir")</p><button disabled="@Working" @onclick="() => Detail(order.Id)">Ver detalhes</button></article>
        }
        @if (detail is not null)
        {
            <section class="card" aria-label="Detalhes da ordem"><h2>@detail.NumeroOS • @detail.EquipamentoNome</h2><p>@detail.Status • @detail.Setor • Solicitante: @detail.OperadorNome</p><p>Responsável: @(detail.TecnicoNome ?? "A definir")</p><p>Trabalho ativo: @detail.TempoAtendimentoMinutos.ToString("N1") min (desconta pausas)</p>
                @if (Client.HasPending(detail.Id)) { <p class="message" role="status">Atendimento salvo no dispositivo — pendente de sincronização. Status e estoque locais aguardam validação do servidor.</p> }
                <p>Diagnóstico: @(detail.CausaFalha ?? "—") • @(detail.ObservacoesTecnicas ?? "—")</p>
                @foreach(var r in detail.Registros) { <p>@r.Timestamp.ToLocalTime().ToString("g") • @r.Tipo • @r.MotivoPausa</p> }
                @foreach(var p in detail.Pecas) { <p>@p.Nome • @p.Quantidade unidade(s)</p> }
                @if (!Client.ReadOnlyMode && Client.Role("Gestor"))
                {
                    <label>Técnico<select aria-label="Técnico" @bind="technician"><option value="@Guid.Empty">Selecione</option>@foreach(var t in technicians) { <option value="@t.Id">@t.Nome</option> }</select></label><button disabled="@Working" @onclick='() => Action("atribuir", new AtribuirTecnicoDto { TecnicoId = technician })'>Atribuir técnico</button>
                }
                @if (!Client.ReadOnlyMode && Client.Role("Tecnico") && detail.Status is not ("Concluida" or "Cancelada"))
                {
                    <h3>Atendimento técnico</h3>
                    <p>@(detail.Status == "Aberta" ? "Inicie o atendimento para registrar peças, pausar ou concluir." : detail.Status == "Pausada" ? "Atendimento pausado. Retome para concluir; você pode registrar peças durante a pausa." : "Atendimento em andamento. Para pausar, informe o motivo abaixo.")</p>
                    <button disabled="@(Working || detail.Status != "Aberta")" @onclick='() => Action("iniciar", new EventoTempoDto())'>Iniciar</button>
                    <label>Motivo da pausa<input disabled="@(Working || detail.Status != "EmAndamento")" @bind="pause" @bind:event="oninput" /></label>
                    <button disabled="@(Working || detail.Status != "EmAndamento" || string.IsNullOrWhiteSpace(pause))" @onclick='() => Action("pausar", new PausarOrdemServicoDto { Motivo = pause })'>Pausar</button>
                    <button disabled="@(Working || detail.Status != "Pausada")" @onclick='() => Action("retomar", new EventoTempoDto())'>Retomar</button>
                    <label>Peça<select aria-label="Peça" @bind="part"><option value="@Guid.Empty">Selecione</option>@foreach(var p in parts) { <option value="@p.Id">@p.Nome (estoque @p.QuantidadeEstoque)</option> }</select></label>
                    <label>Quantidade<input type="number" min="1" @bind="quantity" /></label><button disabled="@(Working || detail.Status is not ("EmAndamento" or "Pausada") || part == Guid.Empty || quantity < 1)" @onclick='() => Action("pecas", new RegistrarPecaDto { PecaId = part, Quantidade = quantity })'>Registrar peça</button>
                    <label>Causa da falha<select aria-label="Causa da falha" @bind="cause"><option value="@Guid.Empty">Selecione</option>@foreach(var c in causes) { <option value="@c.Id">@c.Descricao</option> }</select></label><label>Observações<textarea @bind="observations"></textarea></label><button disabled="@(Working || detail.Status != "EmAndamento" || cause == Guid.Empty)" @onclick='() => Action("concluir", new ConcluirOrdemServicoDto { CausaFalhaId = cause, ObservacoesTecnicas = observations })'>Concluir</button>
                    @if (!Client.TechnicalOfflineEnabled) { <p>Estas ações exigem conexão. Em caso de resposta perdida, consulte a ordem e o estoque antes de repetir.</p> }
                }
            </section>
        }
    }
    else if(area == "Usuários" && Client.Role("Gestor"))
    {
        <Usuarios OnSaved="Load" />
    }
    else if(area == "Cadastros" && Client.Role("Gestor"))
    {
        <Cadastros OnSaved="Load" />
    }
    else if(area == "Equipamentos e peças" && (Client.Role("Gestor") || Client.Role("Tecnico")))
    {
        <h1>Equipamentos e peças</h1>
        @foreach(var e in equipment) { <article class="card"><h2>@e.Nome</h2><p>@e.CodigoPatrimonio • @e.Setor</p><h3>Histórico disponível para seu perfil</h3>@foreach(var o in orders.Where(o => o.EquipamentoNome == e.Nome)) { <p>@o.NumeroOS • @o.Status • @o.DescricaoProblema</p> }</article> }
        <h2>Estoque</h2>@foreach(var p in parts) { <article class="card">@p.Codigo • @p.Nome • @p.QuantidadeEstoque unidade(s) @(p.Critica ? "• Crítica" : "")</article> }
    }
    else if(area == "Preventivas" && (Client.Role("Gestor") || Client.Role("Tecnico")))
    {
        <Preventivas OnBusy="PreventiveBusy" />
    }
    else if(area == "Indicadores" && Client.Role("Gestor"))
    {
        <Indicadores @ref="indicatorPanel" Setores="equipment.Select(e => e.Setor)" />
    }
    </WorkspaceShell>
}
</fieldset>
@if (Working) { <p role="status">Processando…</p> }
@if (!string.IsNullOrEmpty(message)) { <p role="alert" class="message">@message</p> }
@if (!string.IsNullOrEmpty(Client.Notice)) { <p role="status" class="message">@Client.Notice</p> }

@code {
    bool ready, working, showPassword;
    bool Working => working;
    void PreventiveBusy(bool busy) => working = busy;
    string ProfileDescription => Client.Role("Gestor")
        ? "Gestor de manutenção: acompanhe todas as ordens, ajuste a atribuição automática dos técnicos e gerencie cadastros e indicadores."
        : Client.Role("Tecnico")
            ? "Técnico de manutenção: abra os detalhes de uma ordem atribuída a você para iniciar, pausar, retomar e concluir o atendimento, registrando peças e causa da falha."
            : Client.Role("Operador")
                ? "Operador de produção: use Abrir chamado para registrar uma nova O.S. e acompanhe as solicitações que você abriu."
                : "Perfil sem acesso às operações de manutenção. Procure o gestor.";
    string OrderDescription => Client.Role("Gestor") ? "Todas as ordens de serviço da equipe."
        : Client.Role("Tecnico") ? "Seus atendimentos: somente ordens atribuídas a você. Se a lista estiver vazia, solicite a atribuição ao gestor."
        : "Suas solicitações: somente ordens que você abriu.";
    string area = "Visão geral", message = "", search = "", status = "", priority = "", pause = "", observations = "";
    string[] priorities = ["Critica", "Alta", "Media", "Baixa"], statuses = ["Aberta", "EmAndamento", "Pausada", "Concluida", "Cancelada"];
    IEnumerable<string> Areas => Client.Role("Gestor") ? ["Visão geral", "Ordens de serviço", "Indicadores", "Preventivas", "Equipamentos e peças", "Cadastros", "Usuários"]
        : Client.Role("Tecnico") ? ["Visão geral", "Ordens de serviço", "Preventivas", "Equipamentos e peças"]
        : ["Visão geral", "Ordens de serviço"];
    LoginDto login = new(); CriarOrdemServicoDto draft = new();
    List<OrdemServicoDto> orders = []; List<EquipamentoDto> equipment = []; List<PecaDto> parts = []; List<UsuarioDto> technicians = []; List<CausaFalhaDto> causes = []; List<PlanoPreventivoDto> plans = [];
    OrdemServicoDetalheDto? detail; Indicadores? indicatorPanel;
    Guid technician, part, cause; int quantity = 1;
    IEnumerable<OrdemServicoDto> Filtered => orders.Where(o => (o.EquipamentoNome.Contains(search, StringComparison.OrdinalIgnoreCase) || o.NumeroOS.Contains(search, StringComparison.OrdinalIgnoreCase)) && (status == "" || o.Status == status) && (priority == "" || o.Prioridade == priority)).OrderBy(o => Array.IndexOf(priorities, o.Prioridade)).ThenByDescending(o => o.DataAbertura);
    protected override async Task OnInitializedAsync()
    {
        Client.Changed += Changed;
        await Run(async () => { await Client.InitializeAsync(); if(Client.Session is not null) await Load(); });
        ready = true;
    }
    void Changed() => _ = InvokeAsync(() =>
    {
        if (Client.TechnicalOfflineEnabled && detail is not null && Client.LocalDetail(detail.Id) is { } updated)
        {
            detail = updated;
            if (!Client.HasPending(updated.Id) && message == "Ação salva no dispositivo; aguardando sincronização.") message = "Ação confirmada pelo servidor.";
            var summary = orders.FirstOrDefault(o => o.Id == updated.Id);
            if (summary is not null) { summary.Status = updated.Status; summary.DataConclusao = updated.DataConclusao; }
        }
        StateHasChanged();
    });
    async Task Run(Func<Task> action)
    {
        if(working) return;
        working = true; message = "";
        try { await action(); } catch(Exception ex) { message = ex.Message; }
        finally { working = false; }
    }
    async Task Load()
    {
        orders = await Client.GetAsync<List<OrdemServicoDto>>("api/ordensservico?minhas=true");
        equipment = await Client.GetAsync<List<EquipamentoDto>>("api/equipamentos");
        if (Client.Role("Gestor") || Client.Role("Tecnico"))
        {
            parts = await Client.GetAsync<List<PecaDto>>("api/pecas");
            causes = await Client.GetAsync<List<CausaFalhaDto>>("api/causas-falha");
            plans = await Client.GetAsync<List<PlanoPreventivoDto>>("api/planos-preventivos");
        }
        else { parts = []; causes = []; plans = []; }
        if(Client.Role("Gestor")) technicians = await Client.GetAsync<List<UsuarioDto>>("api/usuarios?tipo=Tecnico");
        if (Client.TechnicalOfflineEnabled && Client.Role("Tecnico"))
        {
            orders = await Client.OverlayTechnicalAsync(orders);
            parts = await Client.TechnicalStockAsync(parts);
            Client.PrepareInBackground();
        }
    }
    Task Login() => Run(async () => { await Client.LoginAsync(login); login = new(); showPassword = false; await Load(); });
    Task Logout() => Run(async () => { await Client.LogoutAsync(); orders = []; equipment = []; parts = []; technicians = []; causes = []; plans = []; detail = null; indicatorPanel = null; draft = new(); technician = part = cause = Guid.Empty; observations = pause = search = status = priority = ""; area = "Visão geral"; });
    Task Refresh() => Run(async () => { if (area == "Indicadores" && indicatorPanel is not null) await indicatorPanel.Refresh(); else await Load(); });
    Task Sync() => Run(async () => { await Client.SyncAsync(); await Load(); });
    Task Switch(string next) => Run(() => { area = next; return Task.CompletedTask; });
    void SearchOrders(string query) { search = query; area = "Ordens de serviço"; }
    Task ShowOrder(Guid id) { area = "Ordens de serviço"; return Detail(id); }
    Task Open() => Run(async () => { if(draft.EquipamentoId == Guid.Empty || string.IsNullOrWhiteSpace(draft.DescricaoProblema)) throw new InvalidOperationException("Informe equipamento e descrição."); await Client.OpenAsync(draft); draft = new(); message = "Chamado salvo no dispositivo. Confira as pendências de envio."; if(Client.Pending == 0) await Load(); });
    Task Detail(Guid id) => Run(async () => { detail = Client.TechnicalOfflineEnabled && Client.Role("Tecnico")
        ? await Client.TechnicalDetailAsync(id) : await Client.GetOnlineAsync<OrdemServicoDetalheDto>($"api/ordensservico/{id}"); pause = observations = ""; part = cause = Guid.Empty; quantity = 1; });
    Task Action(string action, object body) => Run(async () =>
    {
        detail = Client.TechnicalOfflineEnabled && Client.Role("Tecnico")
            ? await Client.RecordTechnicalAsync(detail!.Id, action, body)
            : await Client.PostAsync<OrdemServicoDetalheDto>($"api/ordensservico/{detail!.Id}/{action}", body);
        var summary = orders.FirstOrDefault(o => o.Id == detail.Id);
        if (summary is not null)
        {
            summary.Status = detail.Status;
            summary.TecnicoNome = detail.TecnicoNome;
            summary.DataConclusao = detail.DataConclusao;
        }
        if (action == "pausar") pause = "";
        message = Client.HasPending(detail.Id) ? "Ação salva no dispositivo; aguardando sincronização." : "Ação confirmada pelo servidor.";
        // A resposta já contém o estado atualizado da O.S.; não bloqueia a tela
        // recarregando todos os cadastros depois de cada evento do atendimento.
        if (action == "pecas")
        {
            var used = parts.FirstOrDefault(p => p.Id == part);
            if (used is not null) used.QuantidadeEstoque -= quantity;
            part = Guid.Empty; quantity = 1;
        }
    });
    public void Dispose() => Client.Changed -= Changed;
}
