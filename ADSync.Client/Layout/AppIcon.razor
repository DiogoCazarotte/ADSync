        case "search": <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /> break;
        case "user": <circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /> break;
