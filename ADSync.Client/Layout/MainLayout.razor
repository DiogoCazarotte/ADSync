@inherits LayoutComponentBase
<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<header class="app-header">
    <a class="brand" href="/" aria-label="ADSync — início"><img class="brand-logo" src="images/adsync-logo-hd.png" alt="ADSync" width="3992" height="2552" /></a>
    <span class="ui-badge ui-badge-outline brand-tenant">SustenNutri</span>
</header>
<div class="connection-shell"><PwaStatus OnlineChanged="ConnectionChanged" /></div>
<CascadingValue Name="DeviceOnline" Value="@online">
    <main id="main-content" tabindex="-1">@Body</main>
</CascadingValue>
<footer class="app-footer"><strong>ADSync</strong><span>Equipamentos em dia. Equipe conectada.</span></footer>

@code {
    bool? online;
    void ConnectionChanged(bool connected) => online = connected;
}
