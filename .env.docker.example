# Copie para .env.docker e preencha privadamente, ou use tools/Initialize-DockerEnv.ps1.
# Formato raw: não envolva os valores inteiros em aspas; $ e # são preservados.
ConnectionStrings__AdSync=Host=SEU_HOST;Port=5432;Database=postgres;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=Require
Jwt__Key=SUBSTITUA_POR_SUA_CHAVE_JWT_EXISTENTE_COM_32_OU_MAIS_CARACTERES
Safety__ReadOnly=false
Offline__Enabled=true
Preventivas__GeracaoAutomaticaHabilitada=true
